{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "types": ["vite/client"],

    "allowArbitraryExtensions": true,

    "jsx": "react-jsx",

    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
