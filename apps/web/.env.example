# Base URL of the Thinkalot API, without a trailing /api/v1.
# Required for production builds; defaults to http://localhost:3000 in development.
VITE_API_URL=http://localhost:3000

# Shows extra home-page copy when not "v1".
VITE_APP_MVP_VERSION=v1

# Optional, development only: play a fixed date (YYYY-MM-DD) instead of today.
# VITE_GAME_DATE=2026-11-13
